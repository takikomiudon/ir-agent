  "methods": [
    {
      "id": "posterior-evsi",
      "source_ids": [
        "heath-manolopoulou-baio.author-voi"
      ],
      "formula": "EVSI = sum_y p(y) max_a sum_theta p(theta|y) U(a,theta) - max_a sum_theta p(theta) U(a,theta)",
      "source_method": "EVSI posterior expected utility / net benefit",
      "adaptation": "Finite-state exact enumeration, using IR replies as imperfect signals instead of health-study observations; not the original moment-matching estimator",
      "requirements": [
        "specified actions/states",
        "normalized prior",
        "per-state reply likelihoods including nonresponse",
        "same-unit utility",
        "dated source/provenance for estimates"
      ],
      "missing_behavior": "unresolved; do not default to 0.5 priors, perfect replies, or fabricated reliability"
    },
    {
      "id": "evpi-upper-bound",
      "source_ids": [
        "heath-manolopoulou-baio.author-voi"
      ],
      "formula": "EVPI = sum_theta p(theta) max_a U(a,theta) - max_a sum_theta p(theta) U(a,theta)",
      "source_method": "Specialize the verified EVPPI formula to the entire parameter vector",
      "adaptation": "Mathematical specialization explicitly derived here, not a checked quotation of Howard (1966)",
      "requirements": [
        "same states/actions/utility before and after information"
      ],
      "missing_behavior": "unresolved; EVPI cannot stand in for actual IR EVSI"
    },
    {
      "id": "net-information-value",
      "source_ids": [
        "heath-manolopoulou-baio.author-voi"
      ],
      "formula": "NetEVSI = EVSI - question_cost",
      "source_method": "Compare study benefits against costs",
      "adaptation": "IR question/research/waiting costs must be explicit and in the same utility unit; avoid double-counting",
      "requirements": [
        "comparable cost utility",
        "decision can still change after waiting"
      ],
      "missing_behavior": "Report EVSI gross only, mark net prioritization unresolved; do not assume cost=0"
    },
    {
      "id": "narrative-model-update",
      "source_ids": [
        "damodaran.valuation-project.spring2025",
        "damodaran.valuation-introduction.spring2025"
      ],
      "source_method": "Narrative -> model numbers -> valuation; reconsider new information and reconciliation before recommendation",
      "adaptation": "A pre-registered IR branch names the input to change; recompute value independently of current market price and signal tone",
      "requirements": [
        "sourced model inputs",
        "price source and timestamp",
        "catalyst horizon",
        "adopted position/risk policy"
      ],
      "missing_behavior": "Do not synthesize purchase/sale thresholds from these sources; unresolved when policy missing"
    },
    {
      "id": "screen-first-candidate-only",
      "source_ids": [
        "anthropic.idea-generation"
      ],
      "source_method": "Style-specific candidate discovery, not final investment conclusion",
      "adaptation": "Keep IR accessibility separate from valuation, liquidity and investment eligibility",
      "requirements": [
        "explicit style",
        "financial definitions and period",
        "missing-data rules"
      ],
      "missing_behavior": "Pending data, not automatic exclusion or fictional pass"
    }
  ],
