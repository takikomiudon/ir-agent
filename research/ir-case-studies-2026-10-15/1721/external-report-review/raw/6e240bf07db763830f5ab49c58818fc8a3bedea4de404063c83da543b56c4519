ileId":"67315be3f9c0b2730a9af8fa","filename":"1721_EN_20241111.pdf","externalUrl":null,"createdAt":"2024-11-11T01:20:37.055Z","locale":"en","format":"PDF","size":"FULL"},{"filepath":"67315ba2f9c0b2730a9af8f4/1721_EN_20241111_Flash.html","fileId":"67315ba2f9c0b2730a9af8f4","filename":"1721_EN_20241111_Flash.html","createdAt":"2024-11-11T01:19:32.367Z","locale":"en","format":"HTML","size":"REGULAR"},{"filepath":"67315bb9f9c0b2730a9af8f6/1721_EN_20241111_Flash.pdf","fileId":"67315bb9f9c0b2730a9af8f6","filename":"1721_EN_20241111_Flash.pdf","externalUrl":null,"createdAt":"2024-11-11T01:19:54.101Z","locale":"en","format":"PDF","size":"REGULAR"},{"filepath":"67315ba2f9c0b2730a9af8f3/1721_EN_20241111_Flash.html","fileId":"67315ba2f9c0b2730a9af8f3","filename":"1721_EN_20241111_Flash.html","createdAt":"2024-11-11T01:19:32.139Z","locale":"en","format":"HTML","size":"TEASER"},{"filepath":"67315bbef9c0b2730a9af8f7/1721_EN_20241111_Flash.pdf","fileId":"67315bbef9c0b2730a9af8f7","filename":"1721_EN_20241111_Flash.pdf","externalUrl":null,"createdAt":"2024-11-11T01:19:59.014Z","locale":"en","format":"PDF","size":"TEASER"}],"notifySubscribers":true,"published":{"ja":true,"en":true},"pushedToPublicAt":{"ja":"2024-11-08T08:48:04.158Z","en":"2024-11-11T01:20:46.607Z"},"updatedAt":"2024-11-11T01:20:46.660Z","createdAt":"2024-11-08T08:48:04.211Z"}],"reportContent":"<div class=\"sections\"><div class=\"report-section report-section-output section\" id=\"6119b1e673b6b10017e54262\" data-section=\"true\"><div class=\"container\"><div class=\"report-view\"><div id=\"6119b1e673b6b10017e54264\" class=\"report-content-block\" data-block=\"heading\"><h1 id=\"title-6119b1e673b6b10017e54264\"><span>概要</span></h1></div><div id=\"6119b1e673b6b10017e54265\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>コムシスホールディングス株式会社（東証PRM 1721、以下同社）は、大手3社の一角を占める通信設備工事会社である。同社グループの中核である日本コムシス株式会社（非上場）は、1951年に設立され、1952年に当時の日本電信電話公社（現在のNTT株式会社（東証PRM 9432）、以下NTTグループ）から、全国初の総合1級業者（通信線路、通信機械、伝送無線各1級）の資格認定を受けた。当該資格認定を受けているのは、同社とエクシオグループ株式会社（東証PRM 1951、以下エクシオグループ社）、株式会社ミライト・ワン（東証PRM 1417、以下ミライト・ワン社）の大手3社のみである。同社は、2003年に日本コムシス株式会社、株式会社三和エレック、東日本システム建設株式会社（いずれも非上場）の株式移転により純粋持株会社として設立された。同社の傘下には8つの企業グループがある。</span></p></div><div id=\"9372fe91-1c28-4f89-afa8-58d20e3a81ab\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社の2026年3月期の業績は、売上高630,658百万円（前期比2.6%増）、営業利益50,904百万円（同10.7%増）、経常利益52,164百万円（同11.8%増）、親会社株主に帰属する当期純利益36,307百万円（同20.7%増）であった。同社は、顧客および事業内容により、通信キャリア事業、ITソリューション事業、社会システム関連事業の3つに事業を区分している。さらに、通信キャリア事業は、NTT設備事業とNCC設備事業（NCC：New Common Carrier、1985年の通信自由化以降に参入した第一種電気通信事業者）に区分される。ただし、同社は統括事業会社を中心としたグループ別にセグメント情報の開示を行っており、事業区分別にセグメント情報を開示していない（事業区分別売上高および営業利益のみ開示している）。</span></p></div><div id=\"a7d8b871-0008-493f-aeea-e823106c8dc3\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>事業別の売上高構成比（2026年3月期）は、NTTグループ向けに通信設備工事を行うNTT設備事業が37.9%、主にKDDI株式会社（東証PRM 9433）、ソフトバンク株式会社（東証PRM 9434）、楽天グループ株式会社（東証PRM 4755）向けに通信設備の工事を行うNCC設備事業が6.9%であった。NTT設備事業とNCC設備事業は、顧客が異なるだけで事業内容は同じであり、合わせて通信キャリア事業と呼ぶ。通信キャリア事業以外では、官公庁や民間企業からIT機器の設置工事や保守、ソフト開発等を請け負うITソリューション事業の売上高構成比が22.0%、道路や水道等のインフラやデータセンター関連の設備工事、再生可能エネルギー関連の設備工事などを行う社会システム関連事業等の売上高構成比が33.2%を占めた。</span></p></div><div id=\"011dee44-c745-4402-8c86-4a3bf256db4e\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社の各事業を取り巻く環境は、既存の通信インフラ施設の整備を主とするNTT設備事業、NCC設備事業などの通信キャリア事業では、有線回線の光ファイバー化工事や都市部のモバイル系の品質対策工事の需要が拡大している。一方で同社のITソリューション事業では、世の中のDX推進等に伴う需要の増加が見込まれ、また社会システム関連事業等では、インフラ施設の耐災害性強化を目的とした政府の計画推進や、民間事業者による投資が活発化しているデータセンター建設が追い風になると考えられる。こうした各事業を取り巻く環境を踏まえて、同社はITソリューション事業と社会システム関連事業等を成長事業と位置付けている。両事業を合わせた売上高構成比は、2020年3月期の47.5%から2026年3月期までの5年度で55.1%まで拡大した。</span></p></div><div id=\"2f993da8-a5fe-4cfc-b3ea-89aab45c5dcd\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社の主力であるNTT設備事業では、同社、エクシオグループ社、ミライト・ワン社の通信建設会社大手3社を中心に市場が寡占化されている。3社とも創業した1950年代にNTTグループから各種工事の資格認定を受けた上で、NTTグループの出身者が社長を務めてきた。寡占化された市場を主戦場としていることもあり、通信建設会社大手3社の2026年3月期の平均売上総利益率は14.9%で平均営業利益率は6.8%（うち同社は14.6%と8.1%）と、総合建設会社全体の平均値（出所：建設経済研究所による「2025年3月期主要建設会社決算分析」）であるそれぞれ11.0%、4.9%と比較して高い。</span></p></div><div id=\"e6515129-e137-492c-8fb8-d3c21bd7fad0\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社の主力のNTT設備事業で行う工事は、NTT東西社の通信ビル外で行うアクセス工事と、同通信ビル内で行うネットワーク工事、そして携帯電話の基地局建設等を行うモバイル工事に大別される。2026年3月期のNTT設備事業の売上高に占める比率は、それぞれ69.0%、11.4%、19.6%であった（それぞれの利益は非開示）。NTTグループの設備投資は、モバイルの通信品質改善や10Gインターネット光回線の増強、メタル回線のマイグレーション・撤去などに対応して増加傾向となっている。これにより、同社のNTT設備工事の受注高、売上高が増加基調にある。</span></p></div><div id=\"e3494bde-3c46-42d7-b10e-d2ab30e07685\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社はNCC設備事業では、NTTグループ以外の大手通信事業者各社（KDDI社、ソフトバンク社、楽天グループ社等）向けに各種工事を行っており、行う工事の内容は概ねNTT設備事業と同様である。NCC設備事業も、各社の携帯電話の基地局工事が中心となっており、5G回線の基地局投資が一巡したことで低水準で推移している。</span></p></div><div id=\"70afbed8-da36-4666-801e-4a8404a1a9a9\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社はITソリューション事業では、官公庁や民間企業等の拠点における配線工事等から、ネットワーク、サーバ、アプリケーションの構築、システムの保守運用サービスまでを行っている。同社は同事業ではフルレイヤーソリューションの提供、事業領域の拡大を図り、グループ内のソフト開発領域2社（コムシス情報システム社及びつうけんアドバンスシステムズ社）とソリューション提供領域2社（日本コムシス社及びサンワコムシスエンジニアリング社）の融合を進める等、グループ各社の連携を強化している。</span></p></div><div id=\"9c8e01ba-eff2-4df9-a1b5-46ca99ee3910\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社は社会システム関連事業等では、基盤・その他（無電柱化工事や上下水道工事等）、電気・通信（道路の照明設備やデータセンターの工事等）、再生可能エネルギー（太陽光発電施設の工事、売電事業等）の3つの分野で事業を展開している。同事業の領域では近年、政府が予算を設けて老朽化したインフラ施設の更新等を進める中、基盤・その他の業績が総じて堅調に推移している。また同社は電気・通信の領域では、近年事業者による投資が活発化しているデータセンター工事案件の取り込みを強化すべく、受注キャパシティの拡大等に努めている。特に、データセンター工事案件は、通信設備工事と電気設備工事が主であり、同社が電話局庁舎の設備工事で培った経験が生かされると同社は考えている。</span></p></div><div id=\"b2046d10-7e3c-446a-ad55-c95088c1d27d\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社の費用構造について、2026年3月期は売上原価率が85.4%、販管費率が6.5%であり、営業利益率は8.1%である。同社の売上原価は材料費や労務費、外注費等の工事原価が中心であり、同社の販管費は人件費が中心である。なお財務面について、同社の2026年3月期末の自己資本比率は70.7%で、同期のROEは9.4%、ROAは9.4%であった。</span></p></div><div id=\"fc71d067-ad5f-4657-8780-9a6ac63e7096\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>通信建設会社の大手3社は、いずれも経営統合によって企業規模を拡大してきた経緯がある。その中で、それぞれにとっての代表的な経営統合の時期は、同社が2003年、エクシオグループ社が2004年、ミライト・ワン社が2010年であった。大手他社に先駆けて経営統合を行って以降合理化に取り組んできた同社では、近年の販管費率が大手他社よりも低く推移しており、それもあって営業利益以下の各段階利益率が大手他社よりも総じて高く推移している。</span></p></div><div id=\"6119b1e673b6b10017e54267\" class=\"report-content-block\" data-block=\"heading\"><h3 id=\"title-6119b1e673b6b10017e54267\"><span>業績動向</span></h3></div><div id=\"50eba3cf-6ded-420c-bf7c-2beed4e219a8\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>2026年3月期通期の連結業績は、売上高630,658百万円（前期比2.6%増）、営業利益50,904百万円（同10.7%増）、経常利益52,164百万円（同11.8%増）、親会社株主に帰属する当期純利益36,307百万円（同20.7%増）。受注高は685,617百万円（同7.3%増）である。事業別の売上高は、通信インフラ分野では、NTT設備事業の固定系の光通信開通工事やモバイル系の通信品質改善工事が伸長した。また、ITソリューション事業ではデータセンター関連の案件が進捗し受注高、売上高ともに伸長した。社会システム関連事業では前年度の一過性要因により減収となったものの同社の計画を上回る受注高、売上高を獲得した。同社は計画を上回る業績を計上したことにより、年間配当を一株当たり15円増配し130円とした。</span></p></div><div id=\"2b989251-3fef-4788-bf36-25f08bb8ca00\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>2027年3月期の会社業績予想は、売上高670,000百万円（前期比6.2%増）、営業利益54,000百万円（同6.1%増）、経常利益55,000百万円（同5.4%増）、親会社株主に帰属する当期純利益37,860百万円（同4.3%増）である。また受注高は720,000百万円（同5.0%増）である。通信事業者各社向けの通信インフラの設備工事は、引き続きNTT設備事業を中心に固定系の光通信開通工事、モバイル系の通信品質改善工事が伸長する見込み。ITソリューション事業では、官公庁や自治体におけるITサービス市場の拡大、大企業のAI関連投資などに伴う受注拡大を見込む。社会システム関連事業等では、大型データセンター案件のほか、高速道路関連設備案件、再生可能エネルギー案件など、インフラ整備を中心とした受注拡大を見込む。</span></p></div><div id=\"6119b1e673b6b10017e5426e\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>同社は2025年5月に、2031年3月期を最終年とする新たな中期経営計画「コムシスグループ2030ビジョン」を策定した。業績目標として2031年3月期に売上高800,000百万円以上（中計経営計画期間中の（2025年3月期比）年平均成長率4.5%）、営業利益60,000百万円以上（同4.5%）を目指す。また、この間のキャッシュの創出を370,000百万円と見込み、株主還元に150,000百万円を割り当てる。総還元性向70%を目安に、毎年5円の増配と機動的な自社株買いを行う。成長投資には200,000百万円を配分する。また、これとは別にM&amp;Aの規模によっては追加の資金調達を行うとしている。</span></p></div><div id=\"6119b1e673b6b10017e5426f\" class=\"report-content-block\" data-block=\"heading\"><h3 id=\"title-6119b1e673b6b10017e5426f\"><span>同社の強みと弱み</span></h3></div><div id=\"6119b1e673b6b10017e54270\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>SR社が考える同社の強みは、次の3点である。</span></p></div><div id=\"63200d1b-fbde-4e2b-8dcb-dfd20c0f5c0b\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>1）NTTグループによる工事資格認定等を背景に寡占化された通信建設市場を主戦場としていることもあり、建設会社としては高い利益率を確保している</span></p></div><div id=\"ed6b4fbb-b100-4136-8a64-032a3bb9399f\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>2）合理化に対する意識の強さと、それを実現するための各種施策の実行力を持つ</span></p></div><div id=\"b75c9fdb-f0d8-489f-a8b9-05397e69531b\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>3）社会のIT化やDXの進展、政府の国土強靭化計画推進、世界的な脱炭素の流れ等の追い風を受けられる事業を展開している</span></p></div><div id=\"e85ff53a-fe7b-4ed4-80d1-eead25d7ba3a\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>一方でSR社が考える同社の弱みは、次の3点である。</span></p></div><div id=\"cfed0b0e-09d5-4ea2-9716-3c64caa7aa29\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>1）業績の面で、特定の大手通信事業者グループに対する依存度が高い</span></p></div><div id=\"0f7c3a06-45d8-42e9-868d-d4e7e07ad192\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>2）主力事業の市場構造上、シェアを拡大することが難しい</span></p></div><div id=\"0296fafe-c922-4f8f-b1fa-9b4f83187b05\" class=\"report-content-block\" data-block=\"paragraph\"><p class=\"paragraph paragraph-normal\"><span>3）成長分野であるIT事業領域での取り組みが、同業他社と比べて遅れてきたとみえる</span></p></div><div id=\"34a330df-3ebe-4961-b0b8-c3f102cc2772\" class=\"report-content-block\" data-block=\"paragraph\"></div></div></div></div><div class=\"report-section report-section-output section\" id=\"6119b1e673b6b10017e54272\" data-section=\"true\"><div class=\"container\"><div class=\"report-view\"><div id=\"6119b1e673b6b10017e54271\" class=\"report-content-block\" data-block=\"heading\"><h1 id=\"title-6119b1e673b6b10017e54271\"><span>主要経営指標の推移</span></h1></div><div id=\"6119b1e673b6b10017e54273\" class=\"report-content-block\" data-block=\"table\"><div class=\"print-break-inside-avoid\"><div class=\"table-responsive\"><table class=\"table table-hover table-report excel-table table-report-extra-compact\" data-excel-table=\"true\"><tbody><tr><th class=\"table-cell-text-normal table-cell-text table-cell-header table-cell-right-border\" style=\"font-weight:700;vertical-align:middle;width:20.37%\" colSpan=\"2\" rowspan=\"1\"><span>損益計算書</span></th><th class=\"table-cell-text-normal table-cell-text table-cell-header\" style=\"text-align:right;font-weight:700;vertical-align:middle;width:7.24%\" colSpan=\"1\" rowspan=\"1\"><span>17年3月期</span></th><th class=\"table-cell-text-normal table-cell-text table-cell-header\" style=\"text-align:right;font-weight:700;vertical-align:middle;width:7.24%\" colSpan=\"1\" rowspan=\"1\"><span>18年3月期</span></th><th class=\"table-cell-text-normal table-cell-text table-cell-header\" style=\"text-align:right;font-weight:700;vertical-align:middle;width:7.24%\" colSpan=\"1\" rowspan=\"1\"><span>19年3月期</span></th><th class=\"table-cell-text-normal table-cell-text table-cell-header\" style=\"text-align:right;font-weight:700;vertical-align:middle;width:7.24%\" colSpan=\"1\" rowspan=\"1\"><span>20年3月期</span></th><th class=\"table-cell-text-normal table-cell-text table-cell-header\" style=\"text-align:right;font-weight:700;v