      "current_known_additions_by_old_condition": [
        {
          "condition_id": "construction-versus-equipment-sales-gross-margin-and-operating-profit",
          "accepted_known": "説明p6のQ1高粗利は竣工件数と竣工に向けた利益計上の時期による。p7機器売上減は主要顧客の生産計画調整を説明し、新規主要顧客獲得等は施策。機器粗利率改善と赤字拡大は両立。",
          "limits": "Q1高粗利を年次正常率や将来利益に延長せず、施策を顧客獲得済/調整終了にしない。"
        },
        {
          "condition_id": "orders-recovery-expectation-versus-results-and-dated-guidance",
          "accepted_known": "説明p14は機器FY受注のFPD需要回復見込みと、2025年3月期に大型受注したドライヤ既受注案件のFY売上計上見込みを分ける。設備工事FY受注は施工体制考慮、売上は手持工事進捗。注記p10の連結受注31,261→36,232百万円と個別31,107→35,156は別Q1フロー。",
          "limits": "新規受注回復と既受注売上計上を一つの成功としない。Q1受注増を年度全体へ延長せず、連結差を子会社寄与/stockへ変換しない。"
        },
        {
          "condition_id": "profit-stages-historical-share-basis-and-cash-realization",
          "accepted_known": "注記p9はsegment利益合計がOPに一致、当Q1 CF未作成、D&A前年170/当年172百万円を説明。これにより初期のCF未読という残余は当scopeで解消したが、旧初期読解履歴は不変。",
          "limits": "CF未作成はCFO0でなく、D&A/現金残高差/受注額をCFO・維持投資・FCFFにしない。正常税・cash税・現金化は未確認。"
        }
      ],
