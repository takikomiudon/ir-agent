  "quotes": [
    {
      "id": "GP-company-original40-goal",
      "source_id": "case-public:9972764ea77dab3888a7f68afe0d3347aeb36aed4f9d6488877e2ac4a73aba0f",
      "source_kind": "issuer_primary_HTML",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/issuer-plan-followup/quotes.json",
      "existing_quote_file_sha256": "b5537bf4a6fa0775696d9847f91c74b57275891452116e508787e67ec387d93c",
      "existing_quote_jsonpath": "$.quotes[0]",
      "pdf_page": null,
      "content_start": 1055,
      "content_end_exclusive": 1124,
      "quote": "02\n収益性の向上\n１．事業活動の効率化（営業利益率7.5%以上・ROE11%以上）\n２．新製品・新商品開発（オリジナル品比率40%以上）",
      "quote_utf8_sha256": "becc9a266e512b47e8304e94ea37b820295d987489ee3eaf6a3cd96e89ed0c65",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "GP-co-creation-merchant-manufacturer-description",
      "source_id": "case-public:9972764ea77dab3888a7f68afe0d3347aeb36aed4f9d6488877e2ac4a73aba0f",
      "source_kind": "issuer_primary_HTML",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/issuer-plan-followup/quotes.json",
      "existing_quote_file_sha256": "b5537bf4a6fa0775696d9847f91c74b57275891452116e508787e67ec387d93c",
      "existing_quote_jsonpath": "$.quotes[1]",
      "pdf_page": null,
      "content_start": 2106,
      "content_end_exclusive": 2409,
      "quote": "2\n新製品・新商品開発（オリジナル品比率40%以上）\n\"協創型メーカー商社\"（※）として社内外協創を推進し、競争上の優位性をもつオリジナル品の創出及び拡販を図ります。\n（※）“協創型メーカー商社”の定義\n①社会課題を解決する手段を多数持っている\n②社内外協創により、新しいオリジナル品を常に生み出すことができる\n③商社的な解決方法、メーカー的な解決方法だけではなく、それらを組み合わせた独自性の高い解決方法まで生み出すことができる（リソースのフル活用）\n④メーカー機能は、自社・グループ企業にとどまらず、協創パートナーの機能も合わせられることができる\n⑤自社内に直販(解決策を小売している)×製造機能がある",
      "quote_utf8_sha256": "5dc5db9a9022a0c1a971fb6abe01fd96654468c51590f196ab1dabcad3156223",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "LV-company-original55-goal",
      "source_id": "case-public:02818ddeb45b03ffd597c857ead6a7f874ad75c7c68b411596058602ca1297a1",
      "source_kind": "issuer_primary_HTML",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/issuer-plan-followup/quotes.json",
      "existing_quote_file_sha256": "b5537bf4a6fa0775696d9847f91c74b57275891452116e508787e67ec387d93c",
      "existing_quote_jsonpath": "$.quotes[5]",
      "pdf_page": null,
      "content_start": 1971,
      "content_end_exclusive": 2092,
      "quote": "競争上の優位性をもったオリジナル品開発の仕組みづくりを行い、\nDX戦略を積極的に推進することで、生産性向上・既存ビジネスの変革・新規ビジネスを創出し、\n①営業利益率8%以上、②ROE11%以上、③オリジナル品比率55%以上の達成を目指します。",
      "quote_utf8_sha256": "c359bd0c51dc5c68412cbe45d941af075850afbfebbfbbada0dfd7112092032b",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "LV-overseas-exclusive-products-context",
      "source_id": "case-public:02818ddeb45b03ffd597c857ead6a7f874ad75c7c68b411596058602ca1297a1",
      "source_kind": "issuer_primary_HTML",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/issuer-plan-followup/quotes.json",
      "existing_quote_file_sha256": "b5537bf4a6fa0775696d9847f91c74b57275891452116e508787e67ec387d93c",
      "existing_quote_jsonpath": "$.quotes[4]",
      "pdf_page": null,
      "content_start": 1825,
      "content_end_exclusive": 1963,
      "quote": "3\n海外展開（事業範囲の拡充）\n01\n既存進出先（中国・タイ・韓国・ドイツ・アメリカ・インドネシア・インド）を軸とした拠点展開（顧客密着）\n02\n現地での販売パートナー、メーカー機能の獲得（業務提携・M＆A）\n03\n海外で独占的な販売ができる商品・自社製品の開発（協創の推進）",
      "quote_utf8_sha256": "a436435c05c9b6b48fcfc3bed7eeb196a742e714b419f76519d354dff43fc95d",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "LV-consolidated-revenue-goal-context",
      "source_id": "case-public:02818ddeb45b03ffd597c857ead6a7f874ad75c7c68b411596058602ca1297a1",
      "source_kind": "issuer_primary_HTML",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/issuer-plan-followup/quotes.json",
      "existing_quote_file_sha256": "b5537bf4a6fa0775696d9847f91c74b57275891452116e508787e67ec387d93c",
      "existing_quote_jsonpath": "$.quotes[3]",
      "pdf_page": null,
      "content_start": 1304,
      "content_end_exclusive": 1411,
      "quote": "既存の基盤を固めながら、ビジネスの主戦場をモノづくりの上流・下流へと広げる“深化”と、\n成長市場をターゲットとする開発活動“探索”に注力し、\nビジネス領域をグローバルに拡げ、連結売上高700億円の達成を目指します。",
      "quote_utf8_sha256": "05c0221704f7b8a010bbc4b5133f29218c9f58e7db79e8eabd4106d4ad35aef3",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "author-watch-ratio-plateau",
      "source_id": "case-public:b87e707ca4bec9077ffecb14be83767b1b4311e45b1d25d26a051c7e59a06656",
      "source_kind": "external_report",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/author-original-product-review/quotes.json",
      "existing_quote_file_sha256": "2c7a5313fd804d1aea7f6f3dd279c17d2c675e314952c54d7edd069b3c2a628c",
      "existing_quote_jsonpath": "$.text_quotes[0]",
      "pdf_page": 45,
      "content_start": 46574,
      "content_end_exclusive": 46678,
      "quote": "同社は、比較的利益率が高い「オリジナル品」の比率を向上させることで営業利益率および ROE の向上につ\n  なげる考え。だが、同社によれば、売上高など他の KPI に比べ伸び悩んでいる様子。動向を注視したい。",
      "quote_utf8_sha256": "9010a4e70f41efa28548a69102008bc1628a8e204a82bb4c7378abc794be92fc",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "p31-LV2030-consolidated-plan-context",
      "source_id": "case-public:b87e707ca4bec9077ffecb14be83767b1b4311e45b1d25d26a051c7e59a06656",
      "source_kind": "external_report",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/author-original-product-review/quotes.json",
      "existing_quote_file_sha256": "2c7a5313fd804d1aea7f6f3dd279c17d2c675e314952c54d7edd069b3c2a628c",
      "existing_quote_jsonpath": "$.text_quotes[6]",
      "pdf_page": 31,
      "content_start": 35979,
      "content_end_exclusive": 36159,
      "quote": "最終年度 31/3 期の連結売上高の目標である 700 億円の内訳について、①現状の業界・業種で 600 億円、\n  ②成長分野で 100 億円を目指す。また、全体 700 億円のうち、③海外販売で 140 億円を見込む。さらに、売\n  上高全体の 55％以上を比較的収益性の高いオリジナル品で占め（26/3 期実績 29.3％）、これを継続したい\n  考え。",
      "quote_utf8_sha256": "3cba0717ade5ff1a858b1643e23bb1c4b23039cad3af95fd98c4449ed9f40ffa",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    },
    {
      "id": "p34-company-intermediate-plan-ratio40",
      "source_id": "case-public:b87e707ca4bec9077ffecb14be83767b1b4311e45b1d25d26a051c7e59a06656",
      "source_kind": "external_report",
      "existing_quote_file": "research/ir-case-studies-2026-10-15/7525/author-original-product-review/quotes.json",
      "existing_quote_file_sha256": "2c7a5313fd804d1aea7f6f3dd279c17d2c675e314952c54d7edd069b3c2a628c",
      "existing_quote_jsonpath": "$.text_quotes[8]",
      "pdf_page": 34,
      "content_start": 38230,
      "content_end_exclusive": 38611,
      "quote": "中計の最終年度である 27/3 期の目標として、連結売上高 600 億円（26/3 期実績 558 億円）を掲げた。\n  内訳は、現状の業界・業種で 525 億円（同 478 億円）、成長分野で 75 億円（同 80 億円）。全体 600\n  億円のうち、海外販売で 96 億円（同 68 億円）、をそれぞれ見込んでいる。\n\n      一方、利益面では、営業利益 45 億円（26/3 期実績 35 億円）、経常利益 47 億円（同 39 億円）を\n  目指す。営業利益率は 7.5％以上（同 6.3％）、ROE は 11％以上（同 11.7％）とした。KPI であるオリジナ\n  ル品の比率を 40％以上（同 29.3％）へ引き上げていくことで、全体の売上高や利益目標を達成したい考え。\n  次項からはオリジナル品の比率を引き上げる取り組みについて解説する。",
      "quote_utf8_sha256": "934d6b30debe115d4a87f92d1ae086d5c66ac756499183674c2909c011a401cc",
      "offset_unit": "zero-based Unicode code points in exact saved source.content; end exclusive"
    }
  ],
