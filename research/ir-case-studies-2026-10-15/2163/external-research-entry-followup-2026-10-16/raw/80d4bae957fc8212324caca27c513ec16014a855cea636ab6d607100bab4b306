     #cookies_btn {
         position: fixed;
         bottom: 10px;
         left: 15px;
         z-index: 9999;
         cursor: pointer;
         opacity: 0;
         transform: translateX(-50px);
         /* transition: transform .6s, opacity 1s ease-in 0.2s; */
         transition: transform .6s;
         transform-style: preserve-3d;
         @media screen and (max-width: 767px) {
            bottom: 5px;
            left: 5px;
        }

     }



     /* When the button becomes visible */
     #cookies_btn.show {
         opacity: 1;
         transform: translateX(0) !important;
         /* Moves into view */
     }

     #cookies_btn .btn_contents .jp_cookie,
     #cookies_btn .btn_contents .en_cookie {
         display: flex;
         align-items: center;
     }

     /* Image inside button */
     #cookies_btn .btn_contents img {
         width: 50px;
         height: 50px;
         /* transition: transform 0.6s ease-in-out; */
         transform: scale(1);
         border-radius: 50%;
         cursor: pointer;

         @media screen and (max-width: 767px) {
             width: 40px;
             height: 40px;
         }
     }

     #cookies_btn .btn_contents .en_cookie img {}

     /* Scale effect on hover */
     #cookies_btn:hover img {
         transform: scale(1.1);
     }

     /* Custom Tooltip */
     #cookies_btn.btn_contents {
         position: relative;
     }

     #cookies_btn .btn_contents .custom-tooltip {
         visibility: hidden;
         opacity: 0;
         background-color: rgba(0, 0, 0, 0.8);
         color: #fff;
         text-align: center;
         padding: 6px 10px;
         border-radius: 5px;
         left: 10px;
         position: relative;
         transition: opacity 0.3s ease-in-out, visibility 0.3s ease-in-out;
         white-space: nowrap;
         font-size: 10px;
         z-index: 999;
     }

     /* Show tooltip on hover */
     #cookies_btn:hover .btn_contents .custom-tooltip {
         visibility: visible;
         opacity: 1;
     }

     @media screen and (max-width: 767px) {
         #cookies_btn {}

         #cookies_btn .en_cookie {}

         #cookies_btn .acc__call-modal {}

