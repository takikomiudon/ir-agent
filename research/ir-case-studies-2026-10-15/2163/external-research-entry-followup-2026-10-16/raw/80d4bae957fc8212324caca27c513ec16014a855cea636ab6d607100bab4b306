<script>
  window.addEventListener("load", function () {
    const hash = window.location.hash;
  
    if (hash === "#/" || hash === "#") {
      const newUrl = location.origin + location.pathname +
        "#/?ajaxUrl=https%3A%2F%2Ffinder.api.mf.marsflag.com%2Fapi%2Fv1%2Ffinder_service%2Fdocuments%2F4ae6f21d%2Fsearch&ct=&d=&doctype=all&htmlLang=ja&imgsize=3&page=1&pagemax=10&q=&sort=0";
  
      window.location.replace(newUrl);
    }
  });
  
// モーダルウィンドウ
  (function () {
    const modal = document.getElementById("extModal");
    const goBtn = document.getElementById("extModalGoBtn");
  
    let currentUrl = null;      // 押されたリンクのURLを保持
    let lastFocused = null;     // フォーカス戻し用
    let isBlankTarget = false;  // target="_blank" かどうか
  
    // モーダルを開く
    function openModal(url, triggerEl, blank) {
      currentUrl   = url;
      lastFocused  = triggerEl;
      isBlankTarget = !!blank;
  
      modal.classList.add("is-active");
      document.body.classList.add("ext-modal-open");
      modal.setAttribute("aria-hidden", "false");
      goBtn.focus();
    }
  
    // モーダルを閉じる
    function closeModal() {
      modal.classList.remove("is-active");
      document.body.classList.remove("ext-modal-open");
      modal.setAttribute("aria-hidden", "true");
  
      if (lastFocused && typeof lastFocused.focus === "function") {
        lastFocused.focus();
      }
      currentUrl = null;
      isBlankTarget = false;
    }
  
    // 「外部サイトへ」ボタン押下
    goBtn.addEventListener("click", function () {
      if (currentUrl) {
        if (isBlankTarget) {
          // 新しいタブで開く
          window.open(currentUrl, "_blank", "noopener");
        } else {
          // 同じタブで遷移
          window.location.href = currentUrl;
        }
      }
    });
  
    // オーバーレイ or × ボタンクリックで閉じる
    modal.addEventListener("click", function (e) {
      if (e.target.matches("[data-ext-modal-close]")) {
        closeModal();
      }
    });
  
    // Escキーで閉じる
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && modal.classList.contains("is-active")) {
        closeModal();
      }
    });
  
    // 外部リンククリックでモーダル表示
    document.addEventListener("click", function (e) {
      const link = e.target.closest(".js-external-link");
      if (!link) return;
  
      // 通常の遷移を止める
      e.preventDefault();
  
      const url   = link.href;
      const blank = link.target === "_blank";  // ここで判定
  
      openModal(url, link, blank);
    });
  })();
  
  //メールマガジンのパラメータを削除
  document.addEventListener('DOMContentLoaded', function () {
    const checkbox = document.getElementById('irmail');
    const button   = document.getElementById('irmail-btn');
  
    // チェックON/OFFでボタンを有効・無効化
    checkbox.addEventListener('change', function () {
      button.disabled = !this.checked;
    });
  
    // ボタンクリックでパラメータ無しで遷移
    button.addEventListener('click', function () {
      if (!checkbox.checked) return; // 念のためガード
  
      // ★ ここでパラメータ無しで遷移
      window.location.href = '/ir/other/mail/form/';
    });
  });
</script>

