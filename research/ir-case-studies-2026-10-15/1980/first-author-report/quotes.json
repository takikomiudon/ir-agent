[{"id": "cover-date-and-authors", "image_path": "images/page-1.png", "image_sha256": "6a2bee58e20e255e42e218d6c22a5e42ba9c3b9e831f6e850eea87ecaab969c0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 276, "page_UTF8_byte_start": 12, "page_character_end": 212, "page_character_start": 12, "pdf_physical_page": 1, "printed_page": 1, "quote": "ダイダン                                                                              2026 年 9 月 14 日\n                1980 東証プライム / 建設業                                  QUICK 企業価値研究所             前田俊明、小勝智恵", "source_UTF8_byte_end": 276, "source_UTF8_byte_start": 12, "source_character_end": 212, "source_character_start": 12, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "not-rated-label", "image_path": "images/page-1.png", "image_sha256": "6a2bee58e20e255e42e218d6c22a5e42ba9c3b9e831f6e850eea87ecaab969c0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 4277, "page_UTF8_byte_start": 3957, "page_character_end": 3001, "page_character_start": 2829, "pdf_physical_page": 1, "printed_page": 1, "quote": "Not Rated\nを更新した。以降下落する場面もあったが、27/3 期 1Q 決算                       本資料は正確性、客観性を重視したスポンサードリサーチレポー\n                                                       トであり、レーティングは付与しておりません。", "source_UTF8_byte_end": 4277, "source_UTF8_byte_start": 3957, "source_character_end": 3001, "source_character_start": 2829, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "company-guidance-QUICK-EPS-row-and-note", "image_path": "images/page-1.png", "image_sha256": "6a2bee58e20e255e42e218d6c22a5e42ba9c3b9e831f6e850eea87ecaab969c0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 5423, "page_UTF8_byte_start": 5175, "page_character_end": 3813, "page_character_start": 3655, "pdf_physical_page": 1, "printed_page": 1, "quote": "連 27/3 期(予想)      265,000   3.4％    36,000     4.4%    36,500          2.0%    27,300        2.0%       210.89\n注 1：予想は会社予想。ただし、予想 EPS は会社予想純利益をベースに当研究所で算出している", "source_UTF8_byte_end": 5423, "source_UTF8_byte_start": 5175, "source_character_end": 3813, "source_character_start": 3655, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "table-unit-and-scope", "image_path": "images/page-1.png", "image_sha256": "6a2bee58e20e255e42e218d6c22a5e42ba9c3b9e831f6e850eea87ecaab969c0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 4931, "page_UTF8_byte_start": 4608, "page_character_end": 3427, "page_character_start": 3212, "pdf_physical_page": 1, "printed_page": 1, "quote": "業績データ   会計基準：日本基準                                                                           （ ％は前期比増減率 ）\n    決算期             売上高(百万円)         営業利益(百万円)         経常利益(百万円)                純利益(百万円)                EPS(円)", "source_UTF8_byte_end": 4931, "source_UTF8_byte_start": 4608, "source_character_end": 3427, "source_character_start": 3212, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "reference-price-date-not-current", "image_path": "images/page-1.png", "image_sha256": "6a2bee58e20e255e42e218d6c22a5e42ba9c3b9e831f6e850eea87ecaab969c0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 2264, "page_UTF8_byte_start": 2199, "page_character_end": 1646, "page_character_start": 1591, "pdf_physical_page": 1, "printed_page": 1, "quote": "株価(26/9/11 終値)                                2,653.0 円", "source_UTF8_byte_end": 2264, "source_UTF8_byte_start": 2199, "source_character_end": 1646, "source_character_start": 1591, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "TSR-price-identity-context", "image_path": "images/page-54.png", "image_sha256": "807e0ca3a8cd45738814789e7de5afd8f83a00e01cb407de71b814509784efbc", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 242, "page_UTF8_byte_start": 41, "page_character_end": 130, "page_character_start": 33, "pdf_physical_page": 54, "printed_page": 54, "quote": "同社の TSR をさらに詳しく分析する（算出方法、理論の詳細は Appendix1 参照）。\n\n           株価は、（1）BPS×PBR、（2）EPS×PER で表せることを利用した。", "source_UTF8_byte_end": 132565, "source_UTF8_byte_start": 132364, "source_character_end": 70467, "source_character_start": 70370, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "TSR-historical-EPS-denominator", "image_path": "images/page-54.png", "image_sha256": "807e0ca3a8cd45738814789e7de5afd8f83a00e01cb407de71b814509784efbc", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 4861, "page_UTF8_byte_start": 4586, "page_character_end": 3977, "page_character_start": 3858, "pdf_physical_page": 54, "printed_page": 54, "quote": "(注1)株価は各年度の各月末値平均。BPS=期末自己資本÷期末発行済み株式数(自己株式を除く)。PBR=株価÷BPS\n      EPS=親会社株主利益÷期中平均発行済み株式数(自己株式除く)。PERは完全予想ベ―ス。PER=株価÷EPS", "source_UTF8_byte_end": 137184, "source_UTF8_byte_start": 136909, "source_character_end": 74314, "source_character_start": 74195, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "CAPM-average-debt-cost-WACC", "image_path": "images/page-57.png", "image_sha256": "150b9676240b67bcfaadac9bd5d7b866b368f6a5521e287a1e412cd0a605c4f0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 600, "page_UTF8_byte_start": 29, "page_character_end": 240, "page_character_start": 21, "pdf_physical_page": 57, "printed_page": 57, "quote": "CAPM を用いて算出した同社の株主資本コストは 9.2%である。株主資本コストは短期的な変動を平準化す\n   るため、足元の数値ではなく直近 12 カ月平均を採用した。負債コストについては、26/3 期の支払利息を期首・\n   期末の平均有利子負債で除する簡便法を用いて計算し、0.8％と想定した。これらを基に有利子負債をグロス\n   （現預金を控除しない総額）ベースとして算定した WACC（加重平均資本コスト）は 9.1％となった。", "source_UTF8_byte_end": 143410, "source_UTF8_byte_start": 142839, "source_character_end": 77403, "source_character_start": 77184, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "cost-estimate-caution", "image_path": "images/page-57.png", "image_sha256": "150b9676240b67bcfaadac9bd5d7b866b368f6a5521e287a1e412cd0a605c4f0", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 1073, "page_UTF8_byte_start": 786, "page_character_end": 435, "page_character_start": 324, "pdf_physical_page": 57, "printed_page": 57, "quote": "CAPM や QUICK 株主資本コストを示したが、これらの資本コストは推計値にすぎない。\n\n     資本コストの推計値は目安として、投資家が想定する資本コストの水準を、対話などを通じて確認することが\n   大切だろう。", "source_UTF8_byte_end": 143883, "source_UTF8_byte_start": 143596, "source_character_end": 77598, "source_character_start": 77487, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "peer-multiple-definition", "image_path": "images/page-58.png", "image_sha256": "f339f8f0390ff24b4ac04936342b6f839f4542f2b7875e94db1ebb0dcba664d1", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 973, "page_UTF8_byte_start": 915, "page_character_end": 843, "page_character_start": 813, "pdf_physical_page": 58, "printed_page": 58, "quote": "(注)PBR=株価÷期末BPS、PER＝株価÷会社予想EPS", "source_UTF8_byte_end": 146406, "source_UTF8_byte_start": 146348, "source_character_end": 79332, "source_character_start": 79302, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "forecast-EPS-current-net-shares-split-definition", "image_path": "images/page-100.png", "image_sha256": "155460c517abc38b941c0059b3600bb6d8c483e297e109b9a2611bd4ef484a2a", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 1234, "page_UTF8_byte_start": 667, "page_character_end": 484, "page_character_start": 277, "pdf_physical_page": 100, "printed_page": 100, "quote": "・EPS（予想）・BPS（実績）：EPS（予想）は予想１株当たり利益の略で、普通株主に帰属しない配当を控除した予\n想純利益を用いて算出。“－”（ハイフン）は利益予想がない場合。この算出に用いる株式数は QUICK が日々算出する\n直近の普通株発行済株式数（自己株式除く）を使用。BPS（実績）は直近実績の１株当たり純資産の略で、QUICK\nが日々算出する１株当たり純資産を使用。株式分割等の影響は遡及修正している。", "source_UTF8_byte_end": 298365, "source_UTF8_byte_start": 297798, "source_character_end": 177867, "source_character_start": 177660, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "issued-share-treasury-inclusion-definition", "image_path": "images/page-100.png", "image_sha256": "155460c517abc38b941c0059b3600bb6d8c483e297e109b9a2611bd4ef484a2a", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 1788, "page_UTF8_byte_start": 1659, "page_character_end": 679, "page_character_start": 632, "pdf_physical_page": 100, "printed_page": 100, "quote": "・普通株発行済株式数：QUICK が日々算出する直近の普通株発行済株式数（自己株式含む）を表示", "source_UTF8_byte_end": 298919, "source_UTF8_byte_start": 298790, "source_character_end": 178062, "source_character_start": 178015, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "contract-creator", "image_path": "images/page-100.png", "image_sha256": "155460c517abc38b941c0059b3600bb6d8c483e297e109b9a2611bd4ef484a2a", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 2934, "page_UTF8_byte_start": 2715, "page_character_end": 1088, "page_character_start": 1003, "pdf_physical_page": 100, "printed_page": 100, "quote": "・本資料は、本資料の対象会社、株式会社 QUICK および野村インベスター・リレーションズ株式会社の 3 社間の契約に基づ\nき、株式会社 QUICK が作成したものです。", "source_UTF8_byte_end": 300065, "source_UTF8_byte_start": 299846, "source_character_end": 178471, "source_character_start": 178386, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "sponsorship-and-independence", "image_path": "images/page-100.png", "image_sha256": "155460c517abc38b941c0059b3600bb6d8c483e297e109b9a2611bd4ef484a2a", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 3451, "page_UTF8_byte_start": 3239, "page_character_end": 1267, "page_character_start": 1191, "pdf_physical_page": 100, "printed_page": 100, "quote": "ただし、株式会社\nQUICK は本資料の作成に当たり対象会社からスポンサー料を受領しているため、本資料の執筆者は対象会社から独立し\nた立場にありません。", "source_UTF8_byte_end": 300582, "source_UTF8_byte_start": 300370, "source_character_end": 178650, "source_character_start": 178574, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}, {"id": "creation-vs-distribution", "image_path": "images/page-101.png", "image_sha256": "70c9622eff52075ba9adf389a57d25bd26267f251993a39146022552b478a222", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved source.content, half-open", "page_UTF8_byte_end": 1931, "page_UTF8_byte_start": 1660, "page_character_end": 699, "page_character_start": 600, "pdf_physical_page": 101, "printed_page": 101, "quote": "・本資料は、株式会社 QUICK、野村證券株式会社、野村インベスター・リレーションズ株式会社が共同で企画し、株式会社\nQUICK が作成、野村インベスター・リレーションズ株式会社が配信をしています。", "source_UTF8_byte_end": 302912, "source_UTF8_byte_start": 302641, "source_character_end": 179504, "source_character_start": 179405, "source_id": "case-public:4df33a50a3198dfa36142fd1c839f0d28598ff26d911ed83b31fe17d2884645f"}]
