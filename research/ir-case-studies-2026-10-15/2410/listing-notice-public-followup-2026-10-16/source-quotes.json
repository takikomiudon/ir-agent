      "physical_pdf_page": 1,
      "quote": "               当社株式の監理銘柄（審査中）指定に関するお知らせ\n\n",
      "Unicode_start": 467,
      "Unicode_end_exclusive": 508,
      "UTF8_start": 645,
      "UTF8_end_exclusive": 734,
      "image_file": "images/01-physical-01.png",
