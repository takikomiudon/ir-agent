  "issuer_explanations": [
    {
      "id": "existing-apparel-profitability",
      "source_quote_ids": [
        "D1-plan-cost-timing",
        "D2-delayed-revision"
      ],
      "finding": "PLAN-Wの最大課題をアパレルブランド事業の収益性悪化とする。2年目の計画乖離後も当初計画に執着し、3年目の高い販売計画に伴う仕入・経費先行と修正遅れがコア減益を招いたという会社説明。",
      "scope_limit": "同社の因果帰属。独立因果識別や金額寄与分解ではなく、これを全グループの各利益段階の完全bridgeとは扱わない。"
    },
    {
      "id": "acquisitions-positive-contribution",
      "source_quote_ids": [
        "D3-acquired-company-contribution",
        "D5-acquired-sales-scale"
      ],
      "finding": "M&Aでグループ入りしたエムシーファッション/ライトオン等の収益貢献上昇を会社が述べる。過去9年間のM&Aの振り返りには取得企業の売上規模も示す。",
      "scope_limit": "累積M&A範囲の叙述。FY2026/2売上増又は親会社利益増への当期寄与額、連結期間、既存事業との定量的分解はこの3頁で確定しない。"
    },
    {
      "id": "reform-and-inventory",
      "source_quote_ids": [
        "D4-inventory-control"
      ],
      "finding": "FY2026/2下期に人員再配置・仕入抑制の構造改革を行い、前期より低い在庫水準に制御しキャッシュ創出につながったという会社説明。",
      "scope_limit": "短期的な痛みも併記。費用額/一過性/以後の回復保証や正常利益への足戻しを認定しない。"
    },
    {
      "id": "forecast-not-current-actual",
      "source_quote_ids": [
        "D6-next-year-profit-contribution"
      ],
      "finding": "取得事業が親会社利益の約4割を稼ぐ記載は2027/2の見通し。",
      "scope_limit": "FY2026/2実績の親利益構成や当期増益の金額bridgeへ流用しない。"
    },
    {
      "id": "management-capital-proxy",
      "source_quote_ids": [
        "D7-capital-chart-profit-definition"
      ],
      "finding": "p22資本配分図はPLAN-W3年とVISION-W3年等を比較し、図の純利益は親会社利益に非資金損益を加減算した指標と注記する。",
      "scope_limit": "法定単年度親利益/CFO/FCFFと同じではない。将来キャッシュ創出力・TSR/ROIC目標を実績/投資家の割引率/公正倍率へ転用しない。"
    }
  ],
