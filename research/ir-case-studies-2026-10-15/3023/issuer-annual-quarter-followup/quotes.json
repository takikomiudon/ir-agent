    {
      "id": "annual-industrial-prior-year-reversal",
      "role": "annual_statement",
      "source_id": "case-public:e3bbb8122c89e992f72e8a1a9cc3d8d40042ff2c56ca141c8ce1d9550d97f7af",
      "physical_page": 4,
      "printed_page": 2,
      "quote": "  産機関連では民間向け各種ポンプの販売及び部品・整備需要が好調に推移し、建機関連でも大口案件で海外向け\n シールド掘進機を販売したものの、全体的には官庁向けで汚泥ポンプの販売が低調に推移し、また、前期に計上し\n た大型案件の反動減により、関連部門の売上高は99億91百万円となり、前連結会計年度と比べ４億29百万円(△4.1\n ％)の減収となりました。一方、セグメント利益については、部品・整備関連が好調に推移したため15億81百万円と\n なり、前連結会計年度と比べ55百万円(3.6％)の増益となりました。\n",
      "offset_unit": "zero-based Unicode code points and UTF8 bytes in exact pdftotext -layout, half-open",
      "text_file": "research/ir-case-studies-2026-10-15/3023/issuer-annual-quarter-followup/text/annual_statement.txt",
