[{"id": "cover-company-code-date-author", "image_path": "images/page-1.png", "image_sha256": "9c55bda1dd7fa9e3af5bd7aec70c5a0cd7db160dfc9697daa3db01dcb7174ad6", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 371, "page_UTF8_byte_start": 98, "page_character_end": 271, "page_character_start": 82, "pdf_physical_page": 1, "printed_page": null, "quote": "ラサ商事\n          3023 東証スタンダード市場\n              企業情報はこちら >>>\n\n\n\n             2026年7月15日（水）\n                執筆：客員アナリスト\n                      古川 聖治\n             FISCO Ltd. Analyst Seiji Furukawa", "source_UTF8_byte_end": 371, "source_UTF8_byte_start": 98, "source_character_end": 271, "source_character_start": 82, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "company-plan-and-author-inference-on-project-reversal", "image_path": "images/page-13.png", "image_sha256": "ae28d9bd99672daf695f48339b334c472baba5ab55c0de3fcb00efe1c427dc16", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 3516, "page_UTF8_byte_start": 2782, "page_character_end": 2060, "page_character_start": 1782, "pdf_physical_page": 13, "printed_page": 11, "quote": "2027年3月期通期の連結業績は、売上高で前期比1.1%増の28,500百万円、営業利益で同15.5%減の2,500百万\n円、経常利益で同14.8%減の2,750百万円、親会社株主に帰属する当期純利益で同15.9%減の2,000百万円と増\n収減益の見通しである。この見通しには前期の大型案件獲得による反動減が反映されているが、定量的な増減要\n因は開示されていない。もっとも、大型案件を獲得した環境設備関連の営業利益は明らかに過去のトレンドから\n乖離しており、その乖離の大きさなどから見て、減益要因として大型案件獲得による反動減の影響が大きいと推\n察される。", "source_UTF8_byte_end": 55317, "source_UTF8_byte_start": 54583, "source_character_end": 35215, "source_character_start": 34937, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "segment-risks-and-project-reversal", "image_path": "images/page-13.png", "image_sha256": "ae28d9bd99672daf695f48339b334c472baba5ab55c0de3fcb00efe1c427dc16", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 4071, "page_UTF8_byte_start": 3519, "page_character_end": 2249, "page_character_start": 2063, "pdf_physical_page": 13, "printed_page": 11, "quote": "なお、事業セグメントに関しては、定性的要因が開示されており、資源・金属素材関連及び化成品関連では中東\n情勢緊迫化の影響がリスク要因として挙げられる。産機・建機関連でも中東情勢緊迫化の影響による仕入価格上\n昇等の懸念はあるが、需要の堅調な推移を背景として、収益は底堅く推移する見通しである。一方、環境設備関\n連及びプラント・設備工事関連では大型案件の反動減が想定されている。", "source_UTF8_byte_end": 55872, "source_UTF8_byte_start": 55320, "source_character_end": 35404, "source_character_start": 35218, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "forecast-table-issuer-origin", "image_path": "images/page-14.png", "image_sha256": "4f31ba9abcbeeb63cc48d078876e98c785ee6fefe7251714590a735705114098", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 1578, "page_UTF8_byte_start": 694, "page_character_end": 1378, "page_character_start": 642, "pdf_physical_page": 14, "printed_page": 12, "quote": "2027年3月期連結業績見通し\n                                                                                        （単位：百万円）\n                                     26/3期                                 27/3期\n                               実績            売上比              予想           売上比              前期比\n      売上高                     28,201               -         28,500                -          1.1%\n      営業利益                     2,958         10.5%            2,500          8.8%           -15.5%\n      経常利益                     3,226         11.4%            2,750          9.6%           -14.8%\n      親会社株主に帰属する\n                               2,378           8.4%           2,000          7.0%           -15.9%\n      当期純利益\n      出所：決算短信よりフィスコ作成", "source_UTF8_byte_end": 57736, "source_UTF8_byte_start": 56852, "source_character_end": 36986, "source_character_start": 36250, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "company-MTP-period", "image_path": "images/page-14.png", "image_sha256": "4f31ba9abcbeeb63cc48d078876e98c785ee6fefe7251714590a735705114098", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 3154, "page_UTF8_byte_start": 2791, "page_character_end": 1976, "page_character_start": 1823, "pdf_physical_page": 14, "printed_page": 12, "quote": "2025年5月に発表した中期経営計画「“Step Forward”Rasa 2027～成長のステージへ～（2026年3月期～\n 2028年3月期）」は、3つのステップのうちSTEP-2に相当し、前中期経営計画で強化を図ってきた経営基盤の\n 下、新たな成長のステージへの一歩を踏み出す3ヶ年と位置付けている。", "source_UTF8_byte_end": 59312, "source_UTF8_byte_start": 58949, "source_character_end": 37584, "source_character_start": 37431, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "company-capital-cost-and-relative-cheapness", "image_path": "images/page-17.png", "image_sha256": "205244a374922056ecf899e9e6fea1f5b67c2af129515ac37b76a4630bf5bdab", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 2303, "page_UTF8_byte_start": 1808, "page_character_end": 1191, "page_character_start": 1010, "pdf_physical_page": 17, "printed_page": 15, "quote": "同社は、株主資本コストをCAPM（資本資産価格モデル）から約4～7%と推計する一方、投資家の期待値として\nは8%程度が求められると認識して、株主資本コストを上回る水準にROEを向上させることを目指してきた。し\nかし、ROEが想定する株主資本コストを上回った時点においても、株価収益率（PER）や株価純資産倍率（PBR）\nで見て株価が割安な水準にとどまると判断し、", "source_UTF8_byte_end": 69668, "source_UTF8_byte_start": 69173, "source_character_end": 43332, "source_character_start": 43151, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "capital-cost-management-context", "image_path": "images/page-17.png", "image_sha256": "205244a374922056ecf899e9e6fea1f5b67c2af129515ac37b76a4630bf5bdab", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 2647, "page_UTF8_byte_start": 2303, "page_character_end": 1313, "page_character_start": 1191, "pdf_physical_page": 17, "printed_page": 15, "quote": "成長戦略の推進やさらなる株主還元、IR活動の強化、人的資本\n経営の推進等の取り組みが必要との認識に至った。こうした認識の下、同社は2025年5月14日開催の取締役会\nにおいて「資本コストや株価を意識した経営の実現に向けた対応」について決議した。", "source_UTF8_byte_end": 70012, "source_UTF8_byte_start": 69668, "source_character_end": 43454, "source_character_start": 43332, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "company-payout-policy-and-planned-DPS", "image_path": "images/page-18.png", "image_sha256": "4e30ea732427960464e4d06c4790ed9b4e256289376b8206d6143605fa13869b", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 1416, "page_UTF8_byte_start": 719, "page_character_end": 854, "page_character_start": 599, "pdf_physical_page": 18, "printed_page": 16, "quote": "同社は株主還元策として配当を実施している。中期経営計画の財務方針に従い、株主への利益還元を重要な経営\n課題の1つと考え、配当性向で40%前後の水準を維持するとともに、機動的な自己株式取得も行うことにより、\n総還元性向を50%以上とすることを基本方針としている。この方針に基づき、連結業績の好調な推移も踏まえ\nて、2026年3月期の1株当たり配当金は8.0円増配の80.0円を実施した。2027年3月期は減益予想ながら、前期\nに増配した1株当たり配当金80.0円を維持する予定であり、株主重視の姿勢を示している。", "source_UTF8_byte_end": 72871, "source_UTF8_byte_start": 72174, "source_character_end": 44961, "source_character_start": 44706, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "disclaimer-commission-and-analysis", "image_path": "images/page-19.png", "image_sha256": "97d72a3246087d2023b8e34af30c417133bb279bfefe5d6bd53e56662460be9e", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 1106, "page_UTF8_byte_start": 777, "page_character_end": 392, "page_character_start": 281, "pdf_physical_page": 19, "printed_page": null, "quote": "本レポートは、対象となる企業の依頼に基づき、企業への電話取材等を通じて当該企業より情報提供を受\nけ、企業から報酬を受け取って作成されています。本レポートに含まれる仮説や結論その他全ての内容は\nフィスコの分析によるものです。", "source_UTF8_byte_end": 76263, "source_UTF8_byte_start": 75934, "source_character_end": 47003, "source_character_start": 46892, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}, {"id": "disclaimer-vintage-and-no-update-duty", "image_path": "images/page-19.png", "image_sha256": "97d72a3246087d2023b8e34af30c417133bb279bfefe5d6bd53e56662460be9e", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext, half-open", "page_UTF8_byte_end": 2117, "page_UTF8_byte_start": 1891, "page_character_end": 737, "page_character_start": 661, "pdf_physical_page": 19, "printed_page": null, "quote": "本レポートに記載された内容は、本レポート作成時点におけるものであり、予告なく変更される場合があ\nります。フィスコは本レポートを更新する義務を負いません。", "source_UTF8_byte_end": 77274, "source_UTF8_byte_start": 77048, "source_character_end": 47348, "source_character_start": 47272, "source_id": "case-public:1a46d5d95c39a234a9a73073accf5b0df19c71cb293d9a1b055f243d0353ac1f"}]
