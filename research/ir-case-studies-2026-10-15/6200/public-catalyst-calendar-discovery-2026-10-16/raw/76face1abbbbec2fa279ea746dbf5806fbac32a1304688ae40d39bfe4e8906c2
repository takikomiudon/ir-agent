<script>
document.addEventListener('DOMContentLoaded', function () {
  var form    = document.getElementById('js-ai-form');
  var toggle  = document.getElementById('ai-toggle');
  var input   = document.getElementById('js-search-field');
  var gParams = document.querySelectorAll('#google-params input');

  // PC幅になったらAIモードに強制リセット
  window.addEventListener('resize', function () {
    if (window.innerWidth > 768 && !toggle.checked) {
      toggle.checked = true;
      toggle.dispatchEvent(new Event('change'));
    }
  });

  toggle.addEventListener('change', function () {
    if (this.checked) {
      // AIモード
      form.action    = '/ai-chatbot/index.html';
      input.name     = 'soraWord';
      input.placeholder = 'ＡＩでじっくり検索する';
      gParams.forEach(function (p) { p.disabled = true; });
    } else {
      // Googleモード
      form.action    = 'https://www.google.co.jp/search';
      input.name     = 'q';
      input.placeholder = 'キーワードで素早く検索する';
      gParams.forEach(function (p) { p.disabled = false; });
    }
  });
});
</script>
