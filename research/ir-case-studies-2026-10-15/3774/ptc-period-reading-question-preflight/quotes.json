    },
    {
      "id": "M03",
      "path": "third_party/anthropic/skills/thesis-tracker/SKILL.md",
      "sha256": "6b4ce2967c5e01c6b42f5c140fa1e94dee2713b5d2de3eb71957ff5a5c11469b",
      "quote": "Track disconfirming evidence as rigorously as confirming evidence",
      "character_start": 2422,
