  "hypotheses": [
    {
      "id": "capex-accounting-hypothesis",
      "kind": "research_hypothesis_not_fact",
      "statement": "Confusing the management CAPEX indicator with gross cash acquisitions, or subtracting a grant twice, can distort normalized cash-flow inputs. A documented bridge may resolve a modeling error; it does not itself prove undervaluation.",
      "supporting_reference_ids": [
        "capex-definition",
        "capex-subsidy",
        "cash-subsidy-line",
        "lease-cf-known"
      ],
      "falsification": [
        "Public reconciliation shows the proposed model already uses consistent scopes and no double count; the question has no incremental value",
        "The purported grant normalization assumption is unsupported or contradicted by issuer accounting notes"
      ],
      "next_public_check": "The November6 2026 next earnings release is scheduled, not yet confirmed published; re-read latest cash-flow and CAPEX disclosures after actual publication."
    },
    {
      "id": "si-mix-monitor",
      "kind": "public-information-monitoring_hypothesis",
      "statement": "The low aggregate SI gross margin reflects a large hardware construction mix; it should not be extrapolated as the margin of recurring SI operations. Any future margin recovery remains an unconfirmed hypothesis.",
      "supporting_reference_ids": [
        "si-margin-known"
      ],
      "falsification": [
        "Later public disclosures show lower gross profit despite recurring sales growth or identify persistent cost pressure",
        "The change is explained by revenue mix alone and provides no incremental unit-profitability evidence"
      ],
      "model_target": "Separate construction sales and operations/maintenance sales; do not invent separately undisclosed gross margins.",
      "ir_question": "excluded_as_already_answered_in_general"
    }
  ],
