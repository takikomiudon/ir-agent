[{"PDF_physical_page": 5, "id": "Q2-unpublished-definitive-material-impact", "image_SHA256": "6608e1ee9da39d4c4e7ca634a388e092420824a45be57f8fa434a981ffa1a340", "image_file": "pages/physical-5.png", "local_document_id": "fsa-guideline-linked-PDF", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext; half-open", "page_UTF8_byte_end": 1360, "page_UTF8_byte_start": 1169, "page_character_end": 486, "page_character_start": 421, "page_text_SHA256": "5d24759c22f62215a9fb301076d7abee8d15f641617da3fd4fcdf6545d35dbfe", "page_text_file": "pages/physical-5.txt", "printed_page": 3, "quote": "本ルールは、未公表の確定的な情報であって、公表されれば有価証券の価額に重\n 要な影響を及ぼす蓋然性のある情報を対象とするものです。", "source_UTF8_byte_end": 7773, "source_UTF8_byte_start": 7582, "source_character_end": 2873, "source_character_start": 2808, "source_text_SHA256": "a3064397031adfa70b0f53ec301dfd09bf873318567b099b9a8713c9ab4c3db4", "source_text_file": "text/01.txt"}, {"PDF_physical_page": 7, "id": "Q4-strategy-discussion-with-qualification", "image_SHA256": "8f4f32de867abaa2a192cfb07d03e9b0ef1f7f4df13885d443ec4ad3934bebda", "image_file": "pages/physical-7.png", "local_document_id": "fsa-guideline-linked-PDF", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext; half-open", "page_UTF8_byte_end": 845, "page_UTF8_byte_start": 28, "page_character_end": 299, "page_character_start": 12, "page_text_SHA256": "56472fa7aa1e64d117b0a9fdbcf39053e574cbaecc8da4dbe70af00251b89686", "page_text_file": "pages/physical-7.txt", "printed_page": 5, "quote": "① 今後の中長期的な企業戦略・計画等に関する経営者と投資家との建設的な議\n  論の中で交わされる情報は、一般的にはそれ自体では本ルールの対象となる情報\n  に該当しないと考えられます。ただし、例えば、中期経営計画の内容として公表\n  を予定している営業利益・純利益に関する具体的な計画内容などが、それ自体と\n  して投資判断に活用できるような、公表されれば有価証券の価額に重要な影響を\n  及ぼす蓋然性のある情報である場合であって、その計画内容を中期経営計画の公\n  表直前に伝達するような場合は、当該情報の伝達が重要情報の伝達に該当する可\n  能性がある点にご留意下さい。", "source_UTF8_byte_end": 12379, "source_UTF8_byte_start": 11562, "source_character_end": 4557, "source_character_start": 4270, "source_text_SHA256": "a3064397031adfa70b0f53ec301dfd09bf873318567b099b9a8713c9ab4c3db4", "source_text_file": "text/01.txt"}, {"PDF_physical_page": 7, "id": "Q4-published-supplement-with-qualification", "image_SHA256": "8f4f32de867abaa2a192cfb07d03e9b0ef1f7f4df13885d443ec4ad3934bebda", "image_file": "pages/physical-7.png", "local_document_id": "fsa-guideline-linked-PDF", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext; half-open", "page_UTF8_byte_end": 1655, "page_UTF8_byte_start": 847, "page_character_end": 585, "page_character_start": 301, "page_text_SHA256": "56472fa7aa1e64d117b0a9fdbcf39053e574cbaecc8da4dbe70af00251b89686", "page_text_file": "pages/physical-7.txt", "printed_page": 5, "quote": "② 既に公表した情報の詳細な内訳や補足説明、公表済の業績予想の前提となった\n  経済の動向の見込みは、一般的にはそれ自体では本ルールの対象となる情報に該\n  当しないと考えられます。ただし、こうした補足説明等の中に、例えば、企業の\n  業績と契約済みの為替予約レートの関係に関する情報であって、その後の実際の\n  為替レートの数値と比較することで容易に今後の企業の業績変化が予測できる\n  ような、それ自体として公表されれば有価証券の価額に重要な影響を及ぼす蓋然\n  性のある情報が含まれる場合は、そのような情報は重要情報に該当する可能性が\n  ある点にご留意下さい。", "source_UTF8_byte_end": 13189, "source_UTF8_byte_start": 12381, "source_character_end": 4843, "source_character_start": 4559, "source_text_SHA256": "a3064397031adfa70b0f53ec301dfd09bf873318567b099b9a8713c9ab4c3db4", "source_text_file": "text/01.txt"}, {"PDF_physical_page": 7, "id": "Q4-mosaic-itself-qualification", "image_SHA256": "8f4f32de867abaa2a192cfb07d03e9b0ef1f7f4df13885d443ec4ad3934bebda", "image_file": "pages/physical-7.png", "local_document_id": "fsa-guideline-linked-PDF", "offset_unit": "Zero-based Unicode code points and UTF8 bytes in saved pdftotext; half-open", "page_UTF8_byte_end": 2075, "page_UTF8_byte_start": 1657, "page_character_end": 733, "page_character_start": 587, "page_text_SHA256": "56472fa7aa1e64d117b0a9fdbcf39053e574cbaecc8da4dbe70af00251b89686", "page_text_file": "pages/physical-7.txt", "printed_page": 5, "quote": "③ 工場見学や事業別説明会で一般に提供されるような情報など、他の情報と組み\n  合わせることで投資判断に活用できるものの、その情報のみでは、直ちに投資判\n  断に影響を及ぼすとはいえない情報（いわゆる「モザイク情報」）は、それ自体\n  では本ルールの対象となる情報に該当しないと考えられます。", "source_UTF8_byte_end": 13609, "source_UTF8_byte_start": 13191, "source_character_end": 4991, "source_character_start": 4845, "source_text_SHA256": "a3064397031adfa70b0f53ec301dfd09bf873318567b099b9a8713c9ab4c3db4", "source_text_file": "text/01.txt"}]
