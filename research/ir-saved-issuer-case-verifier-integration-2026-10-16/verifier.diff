+    required_capture = {'url', 'response_url', 'method', 'HTTP_status', 'complete_body', 'error', 'http_get_started_at',
+                        'headers_received_at', 'http_get_completed_at', 'raw_saved_at', 'raw_sha256',
+                        'byte_count', 'raw_file', 'PDF_magic', 'accepted_PDF_for_local_reading'}
+    if not required_capture <= set(capture):
+        return unknown('incomplete_saved_issuer_pdf_capture_profile')
+
+    def fixed(name, value, expected):
+        # None is a declared no-error/no-publication value, not missing evidence.
+        matched = type(value) is type(expected) and value == expected
+        checks.append({'name': name, 'status': 'matched' if matched else 'mismatch',
+                       'reason_codes': [] if matched else [name + '_mismatch']})
+
+    for node, label in ((snapshot, 'snapshot'), (capture, 'capture')):
+        status_key = 'http_status' if label == 'snapshot' else 'HTTP_status'
+        integer(node[status_key], label + ' status')
+        if node['error'] is not None: text(node['error'], label + ' error')
+        fixed(label + '_HTTP200', node[status_key], 200)
+        fixed(label + '_no_error', node['error'], None)
+        text(node['url'], label + ' URL')
+        checks.append(_comparison(label + '_source_url', node['url'], checked['url']))
+        raw_sha = node['sha256' if label == 'snapshot' else 'raw_sha256']
+        _hash(raw_sha, label + ' raw SHA')
+        checks.append(_comparison(label + '_raw_sha', _sha(raw) if raw is not None else None, raw_sha))
+    text(capture['response_url'], 'capture response URL')
+    checks.append(_comparison('capture_response_source_url', capture['response_url'], checked['url']))
+    integer(capture['byte_count'], 'capture byte_count')
+    checks.append(_comparison('capture_raw_byte_count', len(raw) if raw is not None else None, capture['byte_count']))
+    text(capture['raw_file'], 'capture raw_file')
+    # Compare resolved safe paths, not an arbitrary basename or a searched hash.
+    capture_path = _relative(case_root, capture['raw_file'])
