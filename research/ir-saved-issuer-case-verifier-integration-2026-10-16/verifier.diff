+def _saved_issuer_pdf_audit(checked, metadata, repository, result):
+    """One observed saved_issuer_case PDF adapter; never guess legacy layouts."""
+    extraction = metadata.get('extraction')
+    if extraction is not None: object_value(extraction, 'metadata.extraction')
+    extraction = extraction or {}
+    if extraction.get('kind') != 'pdf_text':
+        result['reason_codes'] = ['unsupported_or_unspecified_saved_issuer_extraction']; return result
+    directory = metadata.get('saved_case_directory')
+    if directory is None:
+        result['reason_codes'] = ['saved_case_directory_unspecified']; return result
+    case_root = _relative(repository, directory)
+    result['case_directory'] = case_root.relative_to(repository).as_posix()
+    checks = result['checks']
+    raw_check, raw = _artifact(case_root, metadata.get('original_raw_file'),
+        metadata.get('original_raw_sha256'), 'raw', byte_count=metadata.get('original_raw_byte_count'))
+    snap_check, snap_raw = _artifact(case_root, metadata.get('original_transport_snapshot'),
+        metadata.get('original_transport_snapshot_sha256'), 'transport_snapshot')
+    text_check, output = _artifact(case_root, extraction.get('saved_file'), extraction.get('sha256'), 'extraction')
+    checks.extend(({'name': 'raw', **raw_check}, {'name': 'transport_snapshot', **snap_check},
+                   {'name': 'extraction', **text_check}))
+    if output is not None:
+        try: output.decode('utf-8')
+        except UnicodeError: raise ValueError('Saved extraction must be valid UTF-8') from None
+    checks.append(_comparison('extraction_source_content_bytes', output, checked['content'].encode('utf-8')))
+
+    def finish():
+        states = [check['status'] for check in checks]
+        result['status'] = 'mismatch' if 'mismatch' in states else 'unknown' if 'unknown' in states else 'matched'
+        result['reason_codes'] = list(dict.fromkeys(reason for check in checks for reason in check['reason_codes']))
+        return result
+
+    def unknown(reason):
+        checks.append({'name': 'saved_issuer_pdf_profile', 'status': 'unknown', 'reason_codes': [reason]})
+        return finish()
+
+    if snap_raw is None or snap_check['status'] != 'matched':
+        return unknown('transport_snapshot_not_matched')
+    snapshot = object_value(parse_json(snap_raw.decode('utf-8')), 'saved issuer transport snapshot')
+    # This exact top-level shape identifies the inspected adapter, not a search
+    # for useful fields. Other builder/HTML/XLSX or legacy snapshots stay unknown.
+    profile_keys = {'url', 'sha256', 'http_status', 'error', 'retrieved_at', 'publication_time',
+                    'content_type', 'original_complete_capture', 'adapter_note'}
+    if set(snapshot) != profile_keys:
+        return unknown('unsupported_or_incomplete_saved_issuer_pdf_snapshot_profile')
+    capture = snapshot['original_complete_capture']
