<script>
  document.addEventListener("DOMContentLoaded", () => {
    const createDomesticRanking = async () => {
      const requestURL = CDN_URL + "/sbisec/json/main-site/domestic-option/s-stock-ranking.json"; // JSONファイルのURL

      try {
        const response = await fetch(requestURL, { cache: "no-store" });
        const json = await response.json();
        const createRankingTable = (dataKey) => {
          const RankingList = json[dataKey];
          // テンプレート要素を取得
          const loopContainer = document.querySelector(`[data-loop="${dataKey}"]`);
          if(loopContainer){
            const template = loopContainer.cloneNode(true);
            // 元の要素は空にする（テンプレートだけ残す）
            loopContainer.innerHTML = "";
            loopContainer.style.display = "none";
            // DocumentFragmentを作成（仮想コンテナ）
            const totalClone = document.createDocumentFragment();

            // データをループして複製＆差し込み
            RankingList.forEach((item, index) => {
              const clone = template.cloneNode(true);
              // [data-${dataKey}]を持つ要素を探して値を差し込み
              clone.querySelectorAll(`[data-${dataKey}]`).forEach(el => {
                const keys = el.getAttribute(`data-${dataKey}`).split(',');
                if (keys[0] === "_rankNum") { //ランキングを設定
                  const rankClass = `${["seeds-first", "seeds-second", "seeds-third"][index] || ""}`;
                  if(rankClass){
                    el.classList.add(rankClass);
                  }
                  el.innerHTML = index + 1;
                } else if(keys[0] === "_href-URL"){
                  el.setAttribute("href", `/ETGate/WPLETsiR001Control/WPLETsiR001Ilst10/getDetailOfStockPriceJP?OutSide=on&getFlg=on&stock_sec_code_mul=${item["brandCode"]}&exchange_code=JPN`)
                } else { //keyの値をそのまま設定
                  el.innerHTML = item[keys[0]] || "";
                }
              });
              // 複製した要素をコンテナに追加
              totalClone.appendChild(clone);
            });
            loopContainer.parentNode.insertBefore(totalClone, loopContainer.nextSibling);
            // 複製元を削除
            loopContainer.remove();
          }
        };
        const createRankingNotes = () => {
          // 各要素をjsonから追加
          const noteElement = json.notes[0];
          if(noteElement){
            // S株デビュー人気銘柄ランキングを表示する
            const contentCaption = document.querySelector('[data-notes="debutRankingNotes"]');
            const notesHtml_debut = `
              <li>ランキングはSBI証券における${noteElement.termFrom}～${noteElement.termTo}の取引データをもとに算出しております。</li>
