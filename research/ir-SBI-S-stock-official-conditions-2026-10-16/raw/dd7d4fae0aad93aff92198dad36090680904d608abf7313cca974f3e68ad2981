  <li class="md-l-utl-mb7" style="line-height: 1" data-banner-container="rightColumnBottom">
    <a href="#" data-banner="href-url">
      <img data-banner="src-image,alt-contents" />
    </a>
  </li>
  <script>
    (() => {
      document.addEventListener("DOMContentLoaded", () => {
        const createBanner = async () => {
          const requestURL = CDN_URL + "/sbisec/json/main-site/banner/right_column_bottom.json";
          try {
            const response = await fetch(requestURL, { cache: "no-store" });
            const json = await response.json();
            const rightColumnBottomBanner = json.banner[0];
            const bannerContainer = document.querySelector('[data-banner-container="rightColumnBottom"]');
            const pageContainer = bannerContainer?.querySelectorAll("[data-banner]");
            if (pageContainer) {
              pageContainer.forEach((item) => {
                const keys = item.getAttribute("data-banner").split(",");
                keys.forEach((key) => {
                  if (key.startsWith("href-")) {
                    item.setAttribute("href", rightColumnBottomBanner[key]);
                    if (!rightColumnBottomBanner[key].includes("sbisec.co.jp/ETGate")) {
                      item.setAttribute("target", "_blank");
                    }
                  } else if (key.startsWith("src-")) {
                    item.setAttribute("src", rightColumnBottomBanner[key]);
                  } else if (key.startsWith("alt-")) {
                    item.setAttribute("alt", rightColumnBottomBanner[key]);
                  }
                });
              });
            }
          } catch (error) {
            console.error("Error fetching or processing JSON data:", error);
          }
        };
        createBanner();
      });
    })();
  </script>
</ul>

