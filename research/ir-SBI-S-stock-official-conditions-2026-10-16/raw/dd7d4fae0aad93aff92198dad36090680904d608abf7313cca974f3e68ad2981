<script>
  (() => {
    document.addEventListener('DOMContentLoaded', () => {
      const higherFooter = document.querySelector('[data-footer="higher"]');
      const switchStyle = () => {
        const viewport = document.querySelector('head meta[name=viewport]');
        if (viewport) {
          higherFooter.setAttribute('data-responsive-footer', '');
        } else {
          higherFooter.removeAttribute('data-responsive-footer');
        }
      };

      const populate = async () => {
        const requestURL = 'https://sbisec.akamaized.net/sbisec/seeds/static/common/notice.json';
        const response = await fetch(requestURL, { cache: 'no-store' });
        const sources = await response.json();
        const list = higherFooter.querySelector('.slc-footer-container');
        list.innerHTML = '';
        sources.forEach((source) => {
          let imgHtml = '';
          if (source.image) {
            imgHtml = `<img src="${source.image}" alt="${source.alt || ''}" class="${source.imageClass || ''}">`;
          }
          const listItem = `
          <li class="slc-footer-item">
            <a href="${source.link}" class="slc-link" target="${source.target || '_self'}">
              ${source.title}
              ${imgHtml}
            </a>
            </li>`;
          list.insertAdjacentHTML('beforeend', listItem);
        });
      };

      populate();

      const headObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          switchStyle();
        });
      });

      const headObserverConfig = {
        subtree: true,
        childList: true,
      };

      switchStyle();
      headObserver.observe(document.head, headObserverConfig);

      const isIOS = () => {
        const userAgent = window.navigator.userAgent || '';
        const maxTouchPoints = window.navigator.maxTouchPoints || 0;
        return /iPhone|iPad|iPod/.test(userAgent) || (/Macintosh/.test(userAgent) && maxTouchPoints > 1);
      };

      const isAndroid = () => {
        const userAgent = window.navigator.userAgent || '';
        return /Android/.test(userAgent);
      };

      const setSwitchViewCookie = (isPcView) => {
        const expires = new Date();
        expires.setFullYear(expires.getFullYear() + 1);
        document.cookie = 'pc_view=' + isPcView + '; expires=' + expires.toUTCString() + '; domain=.sbisec.co.jp; path=/';
      };

      const getSwitchViewCookie = () => {
        const cookies = document.cookie.split('; ').reduce((acc, cookie) => {
          const [key, value] = cookie.split('=');
          acc[key] = value;
          return acc;
        }, {});
        return cookies?.pc_view;
      };

      const switchView = () => {
        const metaViewports = document.querySelectorAll('meta[name="viewport"]');
        const switchViewButton = document.querySelector('.slc-switch-view');
        const pcViewport = 'width=1280';
        const mobileViewport = 'width=device-width, initial-scale=1.0, maximum-scale=1.0';
        if (!metaViewports.length || !switchViewButton || !(isIOS() || isAndroid()) || document.querySelector('[data-non-responsive-page]')) return;

        const setViewportContent = (content) => {
          metaViewports.forEach((metaViewport) => {
            metaViewport.setAttribute('content', content);
          });
        };

        const applySwitchView = (isPcView, isFirstView) => {
          if (isFirstView && isAndroid() && isPcView) {
            setViewportContent(`width=1280, initial-scale=${window.visualViewport.width / 1280}`);
            const onResizeViewport = () => {
              if (metaViewports[0].getAttribute('content').includes('width=1280, initial-scale=')) {
                setViewportContent(pcViewport);
              }
            };
            window.visualViewport.addEventListener('resize', onResizeViewport, { once: true });
          } else {
            setViewportContent(isPcView ? pcViewport : mobileViewport);
          }
          switchViewButton.id = isPcView ? 'krt_pc_view' : 'krt_sp_view';
          switchViewButton.innerHTML = `
          <img src="https://sbisec.akamaized.net/sbisec/seeds/design-system/images/font-icon/${isPcView ? 'mobile' : 'desktop'}.svg" alt="" class="slc-switch-view-icon"/>${
            isPcView ? 'モバイル版表示' : 'PC版表示'
          }`;
        };

        const isPcView = getSwitchViewCookie() ? JSON.parse(getSwitchViewCookie()) : metaViewports[0].getAttribute('content') === pcViewport;
        switchViewButton.style.display = 'inline-flex';
        document.querySelector('.slc-product-footer').style.marginTop = '120px';
        applySwitchView(isPcView, true);

        switchViewButton.addEventListener('click', () => {
          const isPcView = metaViewports[0].getAttribute('content') === pcViewport;
          setSwitchViewCookie(!isPcView);
          applySwitchView(!isPcView, false);
          setTimeout(() => {
            document.documentElement.style.scrollBehavior = 'auto';
            window.scrollTo({ top: 0 });
            document.documentElement.style.scrollBehavior = '';
            if (isIOS()) {
              window.dispatchEvent(new Event('resize'));
            }
          }, 100);
        });
      };
      switchView();
    });
  })();
</script>
