<script>
  (() => {
    document.addEventListener("DOMContentLoaded", () => {
      const createBanner = async () => {
        const requestURL = CDN_URL + "/sbisec/json/main-site/banner/right_column_upper.json";
        try {
          const response = await fetch(requestURL, { cache: "no-store" });
          const json = await response.json();
          const rightColumnUpperBanner = json.banner[0];
          const bannerContainer = document.querySelector('[data-banner-container="rightColumnUpper"]');
          const pageContainer = bannerContainer?.querySelectorAll("[data-banner]");
          if (pageContainer) {
            pageContainer.forEach((item) => {
              const keys = item.getAttribute("data-banner").split(",");
              keys.forEach((key) => {
                if (key.startsWith("href-")) {
                  item.setAttribute("href", rightColumnUpperBanner[key]);
                  if (!rightColumnUpperBanner[key].includes("sbisec.co.jp/ETGate")) {
                    item.setAttribute("target", "_blank");
                  }
                } else if (key.startsWith("src-")) {
                  item.setAttribute("src", rightColumnUpperBanner[key]);
                } else if (key.startsWith("alt-")) {
                  item.setAttribute("alt", rightColumnUpperBanner[key]);
                }
              });
            });
          }
        } catch (error) {
          console.error("Error fetching or processing JSON data:", error);
        }
      };
      createBanner();
    });
  })();
</script>
